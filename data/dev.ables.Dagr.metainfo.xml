<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>dev.ables.Dagr</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Dagr</name>
  <summary>A simple, priority-ordered task list</summary>
  <description>
    <p>
      One window, one list, ordered by priority. Add a task by typing and
      pressing Enter; everything else is one click away: complete, edit,
      re-prioritize, delete with undo.
    </p>
    <p>
      Priorities are fully user-defined and the list order, default priority
      and other behaviour are adjustable in Preferences. The app also acts as
      an MCP server, so AI assistants can do everything you can.
    </p>
  </description>
  <launchable type="desktop-id">dev.ables.Dagr.desktop</launchable>
  <url type="homepage">https://dagr.bles.nu</url>
  <developer id="dev.ables">
    <name>Ale</name>
  </developer>
  <content_rating type="oars-1.1"/>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
  </supports>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <branding>
    <color type="primary" scheme_preference="light">#99c1f1</color>
    <color type="primary" scheme_preference="dark">#1a5fb4</color>
  </branding>
  <releases>
    <release version="0.1.0" date="2026-09-11">
      <description><p>Initial development version.</p></description>
    </release>
  </releases>
</component>
